---
import SeriesGrid from './SeriesGrid.astro';
---

<div class="cm-landing not-content">
  <section class="intro" aria-labelledby="_top">
    <div class="intro-title">
      <h1 id="_top" data-page-title>Machine learning,<br /><span>cooked from scratch.</span></h1>
    </div>
    <div class="intro-copy">
      <p class="intro-description">Slow-stewed ML knowledge and recipes you can actually follow.</p>
      <div class="intro-actions">
        <a class="start-link" href="/tutorials/">Start learning <span aria-hidden="true">↗</span></a>
      </div>
    </div>

  </section>

  <section class="explore" id="explore" aria-labelledby="explore-title">
    <h2 id="explore-title">Explore</h2>
    <SeriesGrid />
  </section>
</div>
<style>
  .cm-landing {
    padding-top: 2rem;
    color: var(--sl-color-white);
  }
  .cm-landing :is(h1, h2, h3, p, ol, ul) { margin: 0; }
  .cm-landing a { text-decoration: none; }
  .cm-landing :is(a, button):focus-visible { outline: 2px solid var(--sl-color-text-accent); outline-offset: 5px; }
  .intro { display: grid; grid-template-columns: 1.15fr 1fr; align-items: center; gap: 3.5rem; padding-block: 1.75rem 3.25rem; }
  .intro h1#_top {
    margin: 0;
    font-size: clamp(2.5rem, 4.2vw, 3.65rem);
    font-weight: 580;
    letter-spacing: -0.055em;
    line-height: 1.12;
  }
  .intro h1 span { color: var(--sl-color-text-accent); }
  .intro-description { max-width: 29rem; color: var(--sl-color-gray-2); font-size: 1.05rem; line-height: 1.8; }
  .intro-actions { display: flex; flex-wrap: wrap; align-items: center; gap: 1.6rem; margin-top: 1.8rem; font-size: 0.875rem; }
  .start-link { display: inline-flex; align-items: center; gap: 1.8rem; padding: 0.85rem 1.1rem; border: 1px solid var(--sl-color-white); border-radius: 4px; background: var(--sl-color-white); color: var(--sl-color-black); font-weight: 550; }
  .start-link:hover { background: var(--sl-color-text-accent); border-color: var(--sl-color-text-accent); color: var(--sl-color-black); }
  .explore { padding-block: 2.5rem 1rem; scroll-margin-top: 1.5rem; }
  .explore h2 { font-size: 1.55rem; font-weight: 650; letter-spacing: -0.02em; line-height: 1.3; }
  @media (max-width: 60rem) {
    .intro { gap: 2rem; grid-template-columns: 1.1fr 1fr; }
    .intro h1#_top { font-size: clamp(2.4rem, 4.5vw, 3rem); }
  }
  @media (max-width: 45rem) {
    .cm-landing { padding-top: 0.75rem; }
    .intro { grid-template-columns: 1fr; gap: 1.5rem; padding-block: 1rem 2rem; }
    .intro h1#_top { font-size: clamp(2.2rem, 9.5vw, 3.4rem); }
    .intro-description { font-size: 0.95rem; }
    .intro-actions { gap: 1.25rem; }
    .explore { padding-top: 2.5rem; }
  }
</style>
