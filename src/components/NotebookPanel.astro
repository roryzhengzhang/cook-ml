<dialog id="cm-notebook-panel" class="cm-notebook-panel not-content" aria-labelledby="cm-notebook-panel-title">
  <div class="cm-notebook-divider" role="separator" tabindex="0" aria-orientation="vertical"
    aria-label="Resize chapter and notebook" aria-controls="cm-notebook-panel"
    aria-valuemin="25" aria-valuemax="75" aria-valuenow="46"></div>
  <div class="cm-notebook-panel-header">
    <h2 id="cm-notebook-panel-title">Python source</h2>
    <a data-notebook-download download>Download full .py</a>
    <button type="button" aria-label="Close notebook panel" title="Close notebook panel" data-notebook-close autofocus>×</button>
  </div>
  <iframe title="Python source workspace"></iframe>
</dialog>

<script>
  import '../labs/notebook-panel.js';
</script>
