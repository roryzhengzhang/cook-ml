---
// Tutorial series, including planned additions.
type Card = { title: string; blurb: string; meta: string; href?: string; cta?: string };

const tutorialSeries: Card[] = [
  {
    title: 'LLM Fundamentals',
    href: '/tutorials/llm-fundamentals/',
    blurb: 'Build a clear mental model of how large language models work.',
    meta: '9 chapters',
    cta: 'Start reading →',
  },
  {
    title: 'LLM Deep Dive',
    href: '/tutorials/llm-deep-dive/',
    blurb: 'Go beyond the basics to understand how frontier models are built, trained, and served at scale.',
    meta: '8 chapters',
    cta: 'Start reading →',
  },
  {
    title: 'Training Tool-Using Agent With RL',
    href: '/tutorials/rl-for-llm-agents/',
    blurb: 'Build a store simulator and train an agent to complete exchanges, recover from tool failures, and learn new policies.',
    meta: '9 chapters',
    cta: 'Start reading →',
  },
  {
    title: 'Agentic System Fundamentals',
    blurb: 'Learn how to turn a language model into a reliable agent that takes actions to complete real tasks.',
    meta: 'Planned',
  },
  {
    title: 'Design Large-Scale Enterprise Agentic Systems',
    blurb: 'Learn how to design agentic systems that run reliably and securely while serving high throughput.',
    meta: 'Planned',
  },
];

const series = tutorialSeries;
---

<div class="cm-grid not-content">
  {
    series.map((s) =>
      s.href ? (
        <a class="card" href={s.href}>
          <span class="meta">{s.meta}</span>
          <span class="title">{s.title}</span>
          <span class="blurb">{s.blurb}</span>
          <span class="cta">{s.cta}</span>
        </a>
      ) : (
        <div class="card planned">
          <span class="meta">{s.meta}</span>
          <span class="title">{s.title}</span>
          <span class="blurb">{s.blurb}</span>
        </div>
      ),
    )
  }
</div>

<style>
  .cm-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(15rem, 1fr));
    gap: 1rem;
    margin-top: 1.25rem;
  }
  .card {
    display: flex;
    flex-direction: column;
    gap: 0.45rem;
    padding: 1.25rem;
    border: 1px solid var(--sl-color-hairline);
    border-radius: 0.75rem;
    background: var(--sl-color-black);
    text-decoration: none;
    color: inherit;
    transition: border-color 0.15s, box-shadow 0.15s;
  }
  a.card:hover {
    border-color: var(--sl-color-text-accent);
    box-shadow: 0 4px 16px rgb(0 0 0 / 0.06);
  }
  .meta {
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    color: var(--cm-brand);
  }
  .planned .meta {
    color: var(--sl-color-gray-3);
  }
  .title {
    font-size: 1.1rem;
    font-weight: 650;
    color: var(--sl-color-white);
  }
  .blurb {
    font-size: 0.9rem;
    line-height: 1.55;
    color: var(--sl-color-gray-3);
  }
  .cta {
    margin-top: auto;
    padding-top: 0.5rem;
    font-size: 0.9rem;
    font-weight: 600;
    color: var(--sl-color-text-accent);
  }
  .planned {
    border-style: dashed;
  }
</style>
